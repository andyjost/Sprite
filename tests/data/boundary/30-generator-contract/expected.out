% python go.py
type -> Results
next -> 1
loop -> 2
next after break -> 3
next at the end -> StopIteration
first -> 1
after close -> []
nothing -> None []
mixed -> ['1', 'EvaluationError: boom', 'StopIteration']
x + 1 =:= 3 -> ['SuspensionError: Evaluation suspended: (=:=)', 'StopIteration']
(x =:= 1) ? (y + 1 =:= 3) -> ['True', 'SuspensionError: Evaluation suspended: (?)', 'StopIteration']
(y + 1 =:= 3) ? (x =:= 1) -> ['True', 'SuspensionError: Evaluation suspended: (?)', 'StopIteration']
