% python go.py
a == b -> True
hash(a) == hash(b) -> True
len({a, b}) -> 1
a == 42 -> True
sorted(coins) -> [1, 2]
sorted(coins, key=str) -> [1, 2]
(str(f), bool(f)) -> ('False', False)
len(n) -> 2
n[0], n[1] -> 1 2
e -> <Term inc 1 :: Int>
list(eval(e)) -> [2]
e after -> <Term inc 1 :: Int>
list(eval(e)) again -> [2]
typeof(e) -> Int
typeof(term(e, type='Bool')) !! ExprTypeMismatchError: exprtype Bool does not match the inferred type Int
