% python go.py
sortValues (set0 coin) -> [[0, 1]]
sortValues (set2 rule 'a' ['x']) -> [['cmd1']]
sortValues (set2 rule 'a' ['y', 'z']) -> [['cmd2']]
sortValues (set2 rule 'b' ['x']) -> [[]]
isEmpty (set2 rule 'b' ['x']) -> [True]
sortValues (set1 inc coin) -> [[1], [2]]
ord2 -> [([10], 0), ([11], 1)]
twice -> [[0, 1, 1, 2]]
sortValues (set1 inc failed) -> []
isEmpty (set1 inc failed) -> []
nested -> [[[0, 1]]]
sortValues (set2 rule 'a' x) -> 11 values, 9 empty sets, and [['cmd1'], ['cmd2']]
values2list (set0 coin) -> [[0, 1]]
typeof (set0 coin) -> Values Int
set0 coin as text -> ['Values [0,1]']
