% python go.py
str(expr('a')) -> "'a'"
typeof 'a' -> 'Char'
typeof 'ab' -> '[Char]'
typeof '' -> '[Char]'
ord 'a' -> [97]
length 'a' -> [1]
length '' -> [0]
'' -> ['']
show 'a' -> ["'a'"]
show (typed 'a' String) -> ['"a"']
typeof ('a', 1) -> 'Num a => (Char, a)'
strInTuple ('a', 1) -> ['a1']
names [('a', 1)] -> [['a']]
names table !! MismatchError: type mismatch in argument 1 of Str.names :: [([Char], Int)] -> [[Char]]
names (typed table) -> [['a', 'b']]
chr 65 -> "<Char 'A'>"
typeof (chr 65) -> 'Char'
ord (chr 65) -> [65]
chr 65, converted -> ['A']
