$ pakcs --nocypm -q :set safe :load horseman :eval 'goal1 m h where m, h free' :quit
{m=S (S O), h=S O} True

$ pakcs --nocypm -q :set safe :load horseman :eval 'goal2 m h where m, h free' :quit
{m=S (S (S (S (S (S O))))), h=S (S O)} True

$ pakcs --nocypm -q :set safe :load horseman :eval 'goal3 m h hd where m, h, hd free' :quit
{m=O, h=S (S O), hd=S (S (S (S (S (S (S (S O)))))))} True
{m=S O, h=S O, hd=S (S (S (S (S (S O)))))} True
{m=S (S O), h=O, hd=S (S (S (S O)))} True

