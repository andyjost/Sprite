% python go.py
length 'a' !! MismatchError: type mismatch in argument 1 of Prelude.length :: [a] -> Int
inc 1 2 !! ArityError: Err.inc :: Int -> Int takes 1 argument, 2 given
succ [succ, pred] !! NoInstanceError: no instance for Enum (a -> a) in argument 1 of Prelude.succ :: Enum a => a -> a
expr(None) !! ConversionError: cannot convert None at the expression; expected a Curry value
eval(show) !! DefaultingError:
    cannot handle the overloaded goal Prelude.show of type Show a => a -> [Char]
      Cannot handle arbitrary overloaded top-level expressions
      add a type signature
typed errors are CurryTypeError -> True
CurryTypeError is a TypeError -> True
EvaluationError is an Exception -> True
CompileError is an Exception -> True
EvaluationSuspended under EvaluationError -> True
except Exception -> caught EvaluationError
except BaseException -> caught EvaluationError
free('x') -> x
compile("1 +") !! CompileError: Unexpected end-of-file
