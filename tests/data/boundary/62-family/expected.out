% python go.py
rel goal1 c -> ['{c=Peter} True', '{c=Susan} True']
rel goal2 g c -> ['{g=Antony, c=Andrew} True', '{g=Antony, c=Peter} True', '{g=Antony, c=Susan} True', '{g=Bill, c=Andrew} True']
con goal1 c -> ['{c=Peter} True', '{c=Susan} True']
con goal2 g c -> ['{g=Antony, c=Andrew} True', '{g=Antony, c=Peter} True', '{g=Antony, c=Susan} True', '{g=Bill, c=Andrew} True']
fun goal1 -> ['John']
fun goal2 c -> ['{c=Peter} True', '{c=Susan} True']
fun goal3 g c -> ['{g=Antony, c=Peter} True', '{g=Antony, c=Andrew} True', '{g=Antony, c=Susan} True', '{g=Bill, c=Andrew} True']
fun goal4 a -> ['{a=Frank} True', '{a=Alice} True', '{a=Maria} True', '{a=Antony} True', '{a=Bill} True', '{a=Christine} True']
nd goal1 -> ['Antony']
nd goal2 c -> ['{c=Peter} Antony', '{c=Andrew} Bill', '{c=Andrew} Antony', '{c=Susan} Antony']
