#!/bin/bash
# Runs the driver with the flags of SPRITE_INTERPRETER_FLAGS, in step mode.
set -euo pipefail
cd "$(dirname "$0")"
: "${SPRITE_HOME:=$(cd ../../../.. && pwd)/install}"
export SPRITE_HOME
export SPRITE_INTERPRETER_FLAGS="${SPRITE_INTERPRETER_FLAGS:-backend:cxx}"
export SPRITE_ROTATION="${SPRITE_ROTATION:-steps:65536}"
export LC_ALL=C.UTF-8 PYTHONIOENCODING=utf-8
unset CURRYPATH
# The rules of the family programs overlap by design: the warning of the front end is off.
export SPRITE_FRONTEND_WARNINGS="${SPRITE_FRONTEND_WARNINGS:-0}"
echo '% python go.py'
"$SPRITE_HOME/bin/python" go.py
