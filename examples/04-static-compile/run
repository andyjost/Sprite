#!/bin/bash
# Runs the example on the reference backend (backend:py; the developer
# notes of the documentation).  The example runs on that backend only; the
# README says why.
set -euo pipefail
cd "$(dirname "$0")"
: "${SPRITE_HOME:=$(cd ../.. && pwd)/install}"
export SPRITE_HOME
export SPRITE_INTERPRETER_FLAGS=backend:py
export LC_ALL=C.UTF-8 PYTHONIOENCODING=utf-8
unset CURRYPATH
# The rules of aux in wildcard_matching overlap by design: the choice is the
# program.  The warning of the Curry front end on overlapping rules is
# noise here, so the script turns it off unless the environment sets
# the variable.
export SPRITE_FRONTEND_WARNINGS="${SPRITE_FRONTEND_WARNINGS:-0}"
echo '% python go.py'
"$SPRITE_HOME/bin/python" go.py
echo '% python wildcard_matching.py'
"$SPRITE_HOME/bin/python" wildcard_matching.py
