#!/bin/bash
# Runs the lesson in a temporary copy of project/ with the flags of
# SPRITE_INTERPRETER_FLAGS.
set -euo pipefail
cd "$(dirname "$0")"
: "${SPRITE_HOME:=$(cd ../.. && pwd)/install}"
export SPRITE_HOME
export SPRITE_INTERPRETER_FLAGS="${SPRITE_INTERPRETER_FLAGS:-backend:cxx}"
export LC_ALL=C.UTF-8 PYTHONIOENCODING=utf-8
unset CURRYPATH
here=$PWD
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# The layout of this directory in a temporary place: links to build.py, to
# Build.curry and to its product directory, so that Sprite translates the
# module once, into .curry here, and copies of the C files, so that the
# build leaves nothing behind.
mkdir -p .curry
ln -s "$here/build.py" "$here/Build.curry" "$here/.curry" "$work"
mkdir "$work/project"
cp project/*.c project/*.h "$work/project"
cd "$work"

# Runs the driver and prints its command line first.
build() {
  echo "% python build.py" "$@"
  "$SPRITE_HOME/bin/python" build.py "$@"
}

build                     # the build from scratch
echo '% project/demo'
project/demo
build                     # nothing to do
# A pause of one second, so that a file system with whole-second timestamps
# sees the touched shape.h as newer than the objects.
sleep 1
echo '% touch project/shape.h'
touch project/shape.h
build shape.h             # what the change rebuilds
build                     # the rebuild of exactly those
