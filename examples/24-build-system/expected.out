explicit:
  main.o <- main.c  cc -c -O2 -o main.o main.c
ambiguous: main.o has 2 rules
  main.o <- main.c  cc -c -O2 -o main.o main.c
  main.o <- main.c  cc -c -o main.o main.c
refused: the build does not start

5. a rule that closes a cycle
explicit:
  shape.h <- demo  ./demo --emit-header shape.h
plan: no value (the rules have a cycle)
status:
