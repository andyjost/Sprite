# Include the Make.include file one level up in the directory hierarchy.
include $(dir $(abspath $(lastword $(MAKEFILE_LIST))))/../Make.include

CFLAGS  += -fPIC
# LDFLAGS += -lLLVM -Wl,--no-undefined
LDFLAGS += -Wl,--no-undefined

# Rules and targets
# =================
.PHONY: all objs
all:: objs libs shlibs
objs:: $(OBJS_OUT)
# shlibs follow libs.  The shared library of cyrt archives the objects of its
# subdirectories through a nested make (see cyrt/Make.include), which must
# not start while the sub-makes of libs compile the same objects.
shlibs:: | libs

# Dependencies
# ============
include $(ROOT_DIR)/src/Make.depends

