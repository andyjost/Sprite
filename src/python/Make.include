.SECONDEXPANSION:
# Compilation
# ===========
LDFLAGS += -L $(OBJECT_ROOT)/cyrt -lcyrt

# In this Python library, each subdirectory is a submodule that creates exactly
# one .so file.  Subdirectories that do not require an .so should say "SHLIB
# :=" in their Makefile.
ifeq ($(origin SHLIB), undefined)
  THIS_DIR = $(notdir $(basename $(shell pwd)))
  SHLIB = _$(THIS_DIR)
  SHLIB_DEPENDS = $$(OBJS_OUT)
  SHLIB_EXTRA_DEPENDS = $(OBJECT_ROOT)/cyrt/libcyrt.so
endif

INSTALL_DIR = $(PREFIX)/python/$(PYTHON_PACKAGE_NAME)/$(shell realpath --relative-to $(ROOT_DIR)/src/python $(shell pwd))

# Include the Make.include file one level up in the directory hierarchy.
include $(dir $(abspath $(lastword $(MAKEFILE_LIST))))/../Make.include

# Python extension modules are not linked against libpython.  The interpreter
# provides those symbols when the module is loaded.  This overrides the
# -Wl,--no-undefined from src/Make.include; it must come after that flag
# because the later flag wins.
LDFLAGS += -Wl,-z,undefs

# An extension module finds libcyrt.so through a run path relative to its
# own location: from $(INSTALL_DIR) to $(PREFIX)/lib.  So import curry works
# without LD_LIBRARY_PATH in any tree that make install writes.  The flag
# goes into a make-only variable: LDFLAGS may come from the environment, and
# make would pass the modified value down to every sub-make.
RPATH_TO_LIB := $(shell realpath -m --relative-to=$(INSTALL_DIR) $(PREFIX)/lib)
SHLIB_POSTDEP_LDFLAGS += -Wl,-rpath,'$$ORIGIN/$(RPATH_TO_LIB)'

# Make libcyrt.so by running make in the cyrt directory.
$(OBJECT_ROOT)/cyrt/libcyrt.so:
	$(MAKE) -C $(ROOT_DIR)/src/cyrt $@
