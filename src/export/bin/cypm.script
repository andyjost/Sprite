#!/usr/bin/env python3
"""Private CPM entry point for tools using the Curry installation prefix."""
from pathlib import Path
import os
import sys

launcher = Path(__file__).resolve()
prefix = launcher.parent.parent
python = prefix / 'tools/python'
if python.is_file() and python.resolve() != Path(sys.executable).resolve():
  os.execv(str(python.resolve()), [str(python.resolve()), str(launcher), *sys.argv[1:]])
sys.path.insert(0, str(prefix / 'python' if (prefix / 'python').is_dir()
                       else prefix.parent.parent))
from curry import config

if os.environ.get('SPRITE_CPM_FORWARDED'):
  sys.exit('Stock CPM is missing; install stock CPM beside configured PAKCS or on PATH')

candidates = []
pakcs = Path(config.installed_path('tools', 'pakcs'))
if pakcs.is_file():
  candidates.append(pakcs.resolve().with_name('cypm'))
candidates += [Path(directory) / 'cypm' for directory in os.get_exec_path()]
for candidate in candidates:
  if candidate.is_file() and candidate.resolve() != launcher and os.access(candidate, os.X_OK):
    command = str(candidate.resolve())
    os.environ['SPRITE_CPM_FORWARDED'] = '1'
    os.execv(command, [command, '-d', 'CURRYBIN=' + str(prefix / 'bin/curry'),
                      *sys.argv[1:]])
sys.exit('cypm is unavailable; install CPM and add its executable to PATH')
