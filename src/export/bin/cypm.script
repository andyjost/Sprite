#!/usr/bin/env python3
"""Private CPM entry point in the Curry home."""
from pathlib import Path
import os
import sys

prefix = Path(__file__).resolve().parents[2]
python = prefix / 'tools/python'
if python.is_file() and python.resolve() != Path(sys.executable).resolve():
  os.execv(str(python.resolve()), [str(python.resolve()), str(Path(__file__).resolve()), *sys.argv[1:]])
if (prefix / 'sysconfig').is_dir():
  sys.path.insert(0, str(prefix / 'python' if (prefix / 'python').is_dir()
                         else prefix.parent.parent))
from curry import config

arguments = sys.argv[1:]
definitions = []
for index, argument in enumerate(arguments):
  if argument in ('-d', '--d', '--define') and index + 1 < len(arguments):
    definitions.append(arguments[index + 1])
  elif argument.startswith(('--define=', '--d=')):
    definitions.append(argument.split('=', 1)[1])
  elif argument.startswith('-d'):
    definitions.append(argument[2:])
# CPM keeps the first definition. An explicit caller selection takes priority.
defaults = ([] if any(value.startswith('CURRYBIN=') for value in definitions)
            else ['-d', 'CURRYBIN=' + str(prefix / 'curry/bin/curry')])
if os.environ.get('SPRITE_CPM_FORWARDED'):
  sys.exit('stock CPM is missing; put a stock cypm executable on PATH')

candidates = [Path(config.installed_path('tools', 'pakcs')).resolve().parent / 'cypm']
candidates.extend(Path(p) / 'cypm' for p in os.get_exec_path())
for candidate in candidates:
  if candidate.is_file() and os.access(candidate, os.X_OK) \
      and candidate.resolve() != Path(__file__).resolve():
    os.environ['SPRITE_CPM_FORWARDED'] = '1'
    os.execv(str(candidate), [str(candidate), *defaults, *arguments])
sys.exit('no CPM executable found; put cypm on PATH')
