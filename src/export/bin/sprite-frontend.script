#!/usr/bin/env python3
"""Private front-end entry point for the frontend-exec package."""
from pathlib import Path
import os
import subprocess
import shutil
import tempfile
import sys

prefix = Path(__file__).resolve().parent.parent
python = prefix / 'tools/python'
if python.is_file() and python.resolve() != Path(sys.executable).resolve():
  os.execv(str(python.resolve()), [str(python.resolve()), str(Path(__file__).resolve()), *sys.argv[1:]])
sys.path.insert(0, str(prefix / 'python' if (prefix / 'python').is_dir()
                       else prefix.parent.parent))
from curry import config
frontend = config.curry_frontend()
if not frontend:
  sys.exit('no Curry front end found; set SPRITE_FRONTEND or put pakcs-frontend on PATH')
# frontend-exec requests its compiler-named output directory. Its library
# lookup must still see the interfaces pinned for Sprite's selected front end.
# An interface-only view also keeps the front end from compiling library
# sources into the installation for a different output directory.
outdir = Path('.curry')
arguments = sys.argv[1:]
for index, argument in enumerate(arguments):
  if argument in ('-o', '--outdir') and index + 1 < len(arguments):
    outdir = Path(arguments[index + 1])
    if outdir.is_absolute():
      try:
        outdir = Path(os.path.relpath(outdir))
      except ValueError:
        pass
      arguments[index + 1] = str(outdir)
  elif argument.startswith('--outdir='):
    outdir = Path(argument.split('=', 1)[1])
    if outdir.is_absolute():
      try:
        outdir = Path(os.path.relpath(outdir))
      except ValueError:
        pass
      arguments[index] = '--outdir=' + str(outdir)
  elif argument in ('--no-outdir', '--no-subdir'):
    outdir = Path('.')
with tempfile.TemporaryDirectory(prefix='sprite-frontend-') as work:
  # Leave enough parents inside the temporary tree for every '..'. The
  # front end applies the output directory to interface paths as well.
  library = Path(work).joinpath('interfaces', *(['parent'] * outdir.parts.count('..')))
  library.mkdir(parents=True)
  for name in config.syslibs():
    parts = name.split('.')
    source = Path(config.installed_path('curry')).joinpath(*parts[:-1],
        '.curry', config.intermediate_subdir(), parts[-1])
    target = library.joinpath(*parts)
    target.parent.mkdir(parents=True, exist_ok=True)
    for suffix in ('.fint', '.icurry'):
      product = source.with_suffix(source.suffix + suffix)
      if product.is_file():
        shutil.copyfile(product, str(target) + suffix)
        nested = library.joinpath(*(outdir.parts[1:] if outdir.anchor else outdir.parts), *parts)
        if nested != target:
          nested.parent.mkdir(parents=True, exist_ok=True)
          shutil.copyfile(product, str(nested) + suffix)
  sys.exit(subprocess.call([frontend, *config.frontend_flags().split(),
                            '-P', str(library), *arguments, '-i', str(library)]))
