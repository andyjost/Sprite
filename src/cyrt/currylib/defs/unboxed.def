// Note: no include guards desired.
#include <type_traits>

#ifndef UBSPEC
#error "Define UBSPEC as a 4-tuple of NAME, FUNC, ARITY, ARGFIELD"
#endif

// The preprocessor helpers.  APPLY expands the tuple before the element
// macro sees it; CAT and STRINGIZE expand their argument before the paste
// and the stringize.  They are undefined at the end with the rest.
#define CYRT_DEF_APPLY(macro, args) macro args
#define CYRT_DEF_ELEM0(a, b, c, d) a
#define CYRT_DEF_ELEM1(a, b, c, d) b
#define CYRT_DEF_ELEM2(a, b, c, d) c
#define CYRT_DEF_ELEM3(a, b, c, d) d
#define CYRT_DEF_CAT(a, b) CYRT_DEF_CAT_I(a, b)
#define CYRT_DEF_CAT_I(a, b) a ## b
#define CYRT_DEF_STRINGIZE(a) CYRT_DEF_STRINGIZE_I(a)
#define CYRT_DEF_STRINGIZE_I(a) #a

#define NAME     CYRT_DEF_APPLY(CYRT_DEF_ELEM0, UBSPEC)
#define FUNC     CYRT_DEF_APPLY(CYRT_DEF_ELEM1, UBSPEC)
#define ARITY    CYRT_DEF_APPLY(CYRT_DEF_ELEM2, UBSPEC)
#define ARGFIELD CYRT_DEF_APPLY(CYRT_DEF_ELEM3, UBSPEC)

#if ARITY != 1
  #if ARITY != 2
    #error "Expected arity 1 or 2."
  #endif
#endif

#define STEP_FUNCTION_NAME  CYRT_DEF_CAT(NAME, _step)
#define INFOTABLE_NAME      CYRT_DEF_CAT(NAME, _Info)

static tag_type STEP_FUNCTION_NAME(RuntimeState * rts, Configuration * C)
{
  Cursor _0 = C->cursor();
  Variable _1 = _0[0];
  auto tagl = rts->hnf(C, &_1);
  if(tagl < T_CTOR) return tagl;
  #if ARITY == 1
    auto value = FUNC(NodeU{_1.target}.ARGFIELD->value);
  #else
    Variable _2 = _0[1];
    auto tagr = rts->hnf(C, &_2);
    if(tagr < T_CTOR) return tagr;
    auto value = FUNC(NodeU{_1.target}.ARGFIELD->value, NodeU{_2.target}.ARGFIELD->value);
  #endif
  // A boxed result is written into the redex: the result has the smallest
  // node size, so it fits.  A Bool result is a pinned constructor, which is
  // never copied into a redex (see Node::rewrite), so the redex is forwarded
  // to it.
  if constexpr(std::is_same<decltype(value),bool>::value)
  {
    _0->forward_to(value ? &True_Info : &False_Info);
    return T_FWD;
  }
  else if constexpr(std::is_same<decltype(value),unboxed_int_type>::value)
    return _0->rewrite(&Int_Info, value);
  else if constexpr(std::is_same<decltype(value),unboxed_float_type>::value)
    return _0->rewrite(&Float_Info, value);
  else if constexpr(std::is_same<decltype(value),unboxed_char_type>::value)
    return _0->rewrite(&Char_Info, value);
  else
  {
    assert(false);
    return E_ERROR;
  }
}

InfoTable const INFOTABLE_NAME {
    /*tag*/        T_FUNC
  , /*arity*/      ARITY
  , /*alloc_size*/ sizeof(CYRT_DEF_CAT(Node, ARITY))
  , /*flags*/      F_STATIC_OBJECT
  , /*name*/       CYRT_DEF_STRINGIZE(NAME)
#if ARITY == 1
  , /*format*/     "p"
#else
  , /*format*/     "pp"
#endif
  , /*step*/       STEP_FUNCTION_NAME
  , /*type*/       nullptr
  };

#undef ARGFIELD
#undef ARITY
#undef CYRT_DEF_APPLY
#undef CYRT_DEF_CAT
#undef CYRT_DEF_CAT_I
#undef CYRT_DEF_ELEM0
#undef CYRT_DEF_ELEM1
#undef CYRT_DEF_ELEM2
#undef CYRT_DEF_ELEM3
#undef CYRT_DEF_STRINGIZE
#undef CYRT_DEF_STRINGIZE_I
#undef UBSPEC
#undef FUNC
#undef INFOTABLE_NAME
#undef NAME
#undef STEP_FUNCTION_NAME
