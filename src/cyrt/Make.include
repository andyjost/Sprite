.SECONDEXPANSION:
LIB_DEPENDS := $$(OBJS_OUT)
SHLIB_DEPENDS := $$(LIB_OUT)
SHLIB_EXTRA_DEPENDS := shlib_extra
SHLIB_PREDEP_LDFLAGS := -Wl,--whole-archive
# The runtime binds its own functions locally (-Bsymbolic-functions), so a
# call from one of its translation units into another does not go through
# the procedure linkage table.  Its symbols stay exported: generated modules
# and the Python bindings resolve them as before.
SHLIB_POSTDEP_LDFLAGS := -Wl,--no-whole-archive -Wl,-Bsymbolic-functions \
                         -lpthread -ldl

SHLIB := libcyrt
RELATIVE_INSTALL_DIR := lib
LIB := cyrt/libcyrt

HEADER_INSTALL_DIR = $(PREFIX)/include/cyrt/$(shell realpath --relative-to $(ROOT_DIR)/src/cyrt $(shell pwd))
EXPORTED_HEADERS := $(wildcard *.h??)

# The C++ backend keeps the precompiled form of cyrt.hpp in this directory
# (see curry.backends.cxx.toolchain.PrecompiledHeader).  Only the top-level
# cyrt directory, the one that holds this file, lists it.
ifeq ($(CURDIR),$(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST))))))
  DIRS_TO_REC_UNINSTALL += $(PREFIX)/include/cyrt/cyrt.hpp.gch
endif

# Include the Make.include file one level up in the directory hierarchy.
include $(dir $(abspath $(lastword $(MAKEFILE_LIST))))/../Make.include

# The objects of the subdirectories reach the archive through this nested
# make, which runs libs here and so in every subdirectory.  Under make -j it
# starts after this make has archived its own objects: the nested make
# archives them too, and two makes on one object race.  (shlibs follows libs
# for the same reason; see ../Make.include.)  The link of the shared library
# then reads the archive after the nested make filled it.
.PHONY: shlib_extra
shlib_extra: | $(LIB_OUT)
	$(MAKE) -C $(ROOT_DIR)/src/cyrt libs
ifdef LIB_INSTALL
# The installed copy of the archive is complete: it is made after the nested
# make, not beside it.
$(LIB_INSTALL): | shlib_extra
endif
