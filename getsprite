# Installs Sprite non-interactively.
#
# Usage:
#
#     wget -qO- https://raw.githubusercontent.com/andyjost/Sprite/master/getsprite | sh
#     curl -sSL https://raw.githubusercontent.com/andyjost/Sprite/master/getsprite | sh
#
# GitHub:
#
#     https://github.com/andyjost/Sprite
#
# Documentation:
#
#     Build it locally: make -C $HOME/Sprite/docs html
#     (output under $HOME/Sprite/object-root/docs/html)

if [ -d $HOME/Sprite ]; then
  echo 1>&2 Found previous installation at $HOME/Sprite.
  set -e
  set -x
  cd "$HOME/Sprite"
  git pull
else
  set -e
  set -x
  cd $HOME
  git clone https://github.com/andyjost/Sprite.git
  cd "$HOME/Sprite"
fi

./configure --install-prereqs --yes
make

set +x
echo
echo "********************************************************************************"
echo "                            Installation succeeded!"
echo "********************************************************************************"
echo
echo "Sprite is installed at $HOME/Sprite/install/bin"
echo
echo "Next steps:"
echo "    - Build the documentation: make -C $HOME/Sprite/docs html"
echo "      (output under $HOME/Sprite/object-root/docs/html; sources at https://github.com/andyjost/Sprite)"
echo "    - Go through the Quickstart Tutorial (in the docs)."
echo "    - Explore the Python API: $HOME/Sprite/install/bin/python -ic 'import curry'"
echo "    - Run the examples under '$HOME/Sprite/examples/'."
echo "    - Run the test suite: make -C $HOME/Sprite test"
echo "    - Install it elsewhere: make -C $HOME/Sprite install PREFIX=/path/to/dir"
echo
