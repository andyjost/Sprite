#!/usr/bin/env python3

import argparse, atexit, os, shutil, subprocess, sys

DIR = os.path.dirname(os.path.realpath(__file__))
CONF = os.path.join(DIR, 'Make.config')
TMP = os.path.join(DIR, 'configure-tmp')
OPTS = None
LOGFILE = 'configure.log'
LOG = open(LOGFILE, 'w')
g_missing_prereqs = []
g_install_steps = []
g_did_pipcheck = False

# The PAKCS release that Sprite is pinned to.  Its library is a copy under
# curry/lib, and its front end writes the FlatCurry that the committed ICurry
# files were made from.  When configure runs without PAKCS, these values name
# the intermediate directories and set the front-end flags.
PINNED_PAKCS_NAME = 'pakcs'
PINNED_PAKCS_VERSION = '3.4.1'
# The Curry front end of the pinned PAKCS.  Another front end writes different
# FlatCurry, and the committed ICurry files and the oracle depend on it.
PINNED_FRONTEND_VERSION = '2.0.0'
# The number of jobs make runs at once when --jobs is not given: a count, or
# 'auto' for one job per processor.  The parallel build passed its timed
# trial from a clean tree (issue #43; see the TODO), so 'auto' is the
# default.  See the root Makefile.
DEFAULT_JOBS = 'auto'

class Tee(object):
  def __init__(self, stream):
    self.term = stream
    self.log = LOG

  def write(self, msg):
    self.term.write(msg)
    self.log.write(msg)

  def flush(self):
    pass

sys.stdout = Tee(sys.stdout)
sys.stderr = Tee(sys.stderr)

@atexit.register
def remove_tmpdir():
  rmdir(TMP)

def rmdir(dirname):
  # If dirname is a symlink to a directory, remove the contents of the target
  # and keep the link.
  if os.path.islink(dirname):
    target = os.path.realpath(dirname)
    if os.path.isdir(target):
      log('Removing the contents of %s (target of %s)' % (target, dirname))
      for name in os.listdir(target):
        path = os.path.join(target, name)
        if os.path.isdir(path) and not os.path.islink(path):
          shutil.rmtree(path)
        else:
          os.remove(path)
  elif os.path.exists(dirname):
    log('Removing %s' % dirname)
    shutil.rmtree(dirname)

# System commands.
def log(msg='', tail='\n'):
  LOG.write(msg)
  LOG.write(tail)

def say(msg='', tail='\n'):
  sys.stdout.write(msg)
  sys.stdout.write(tail)

def warn(msg='', tail='\n'):
  sys.stderr.write(msg)
  sys.stderr.write(tail)

def which(name, path=None):
  if path is None:
    path = os.environ['PATH'].split(':')
  for dirname in path:
    dirname = dirname.strip()
    filename = os.path.join(dirname, name)
    if os.path.exists(filename):
      return filename
  return

def shell(cmd):
  ans = subprocess.check_output(cmd, shell=True, stderr=subprocess.STDOUT)
  return ans.decode('utf-8').strip()

def shellexec(cmd):
  child = subprocess.Popen(cmd, shell=True)

  try:
    out,err = child.communicate()
  except:
    child.kill()
    raise

  try:
    retcode = child.wait()
  except:
    child.kill()
    raise

  return retcode == os.EX_OK

def commit(settings, variable_name, value, validation=None):
  if value is None:
    return False
  if variable_name is not None:
    log('Selecting %s=%r' % (variable_name, value))
  for v in (validation or []):
    if not v(value):
      return False
  if settings is not None:
    settings[variable_name] = value
  return True

def abort(soft=False):
  if soft:
    warn('\nAborted.')
  else:
    warn('\nSee %s for details.' % LOGFILE)
    warn('\nAborted.')
  sys.exit(1)

def abort_python():
  warn('\nPython development files could not be located.')
  warn('If you are using a package manager, you might need to install one of the -dev packages.')
  abort()

def jobs_type(value):
  '''The argument of --jobs: a positive integer, as a string, or 'auto'.'''
  if value == 'auto':
    return value
  try:
    count = int(value)
  except ValueError:
    count = 0
  if count < 1:
    raise argparse.ArgumentTypeError(
        'expected a positive integer or auto, got %r' % value
      )
  return str(count)

def get_options():
  global OPTS
  parser = argparse.ArgumentParser(
      description='Configure Sprite Builds'
    , usage='\n    configure [-Dfi] [--with...] [--jobs N|auto] [--install-prereqs[-only] [--yes] [--pip-nosudo]]'
            '\n    configure [-Dfi] [--with...] --check-prereqs [--pip-nosudo]'
    )

  parser.add_argument('-D', '--doc', action='store_true', help='check dependencies needed to build documentation')
  parser.add_argument('-f', '--fast', action='store_true', help='skip expensive checks')
  parser.add_argument('-i', '--interactive', action='store_true', help='configure interactively')

  prereqs = parser.add_argument_group('prerequisite arguments', 'Checks or installs prerequites.')
  prereqs.add_argument('--check-prereqs', action='store_true', help='list missing prerequisites but do not install them')
  prereqs.add_argument('--install-prereqs', action='store_true', help='install missing prerequisites and configure')
  prereqs.add_argument('--install-prereqs-only', action='store_true', help='install missing prerequisites only; '
                                                       'do not remove prior builds or write a configuruation file')
  prereqs.add_argument('-y', '--yes', action='store_true', help='do not prompt before installing prerequisites')
  prereqs.add_argument('--pip-nosudo', action='store_true', help='accepted for compatibility; Python packages are always installed with --user')

  versions = parser.add_argument_group(
      'software selection arguments'
    , 'Specifies external programs.  Program names are taken, in order of '
      'preference, from: (1) the command-line arguments below; (2) the '
      'environment; (3) the defaults shown below.  If the program name is not an '
      'absolute path, then PATH will be searched to find the program.'
    )
  versions.add_argument('--with-cc'             , type=str, metavar='gcc', help='specifies the C compiler (env: CC)')
  versions.add_argument('--with-ccache'         , type=str, metavar='ccache', nargs='?', const='ccache', help='puts ccache in front of the compilers of the build and of the post-install compiler (env: CCACHE); the value names the program, by default ccache; an empty value leaves it out')
  versions.add_argument('--with-cxx'            , type=str, metavar='g++', help='specifies the C++ compiler (env: CXX)')
  versions.add_argument('--with-cxx-postinstall', type=str, metavar='g++', help='specifies the C++ compiler used after installation (env: CXX)')
  versions.add_argument('--with-curry-frontend' , type=str, metavar='pakcs-frontend', help='specifies the Curry front end (env: CURRY_FRONTEND); by default the one of PAKCS; an empty value leaves it out')
  versions.add_argument('--with-icurry'         , type=str, metavar='icurry', help='specifies the icurry executable (env: ICURRY); optional when the front end is found; an empty value leaves it out')
  versions.add_argument('--with-pakcs'          , type=str, metavar='pakcs', help='specifies the PAKCS executable (env: PAKCS); optional when the front end is named; an empty value leaves it out')
  versions.add_argument('--with-prolog'         , type=str, metavar='swipl', help='specifies the Prolog executable (env: PROLOG)')
  versions.add_argument('--with-python'         , type=str, metavar='python3', help='specifies the Python executable (env: PYTHON)')

  build = parser.add_argument_group('build arguments', 'Controls how make builds Sprite.')
  build.add_argument('-j', '--jobs', type=jobs_type, metavar='N|auto', help='the number of jobs make runs at once: a count, or auto for one job per processor (default: %s); 1 is a serial build; a -j on the make command line wins' % DEFAULT_JOBS)

  dev = parser.add_argument_group('development arguments', 'Enables features for Sprite developers.')
  dev.add_argument('--cache', type=str, metavar="['all'|'icurry'|'json']", help='enables caching; useful when the same Curry program will be run many times')
  dev.add_argument('--curry2icurry', type=str, choices=['frontend', 'icurry'], metavar="['frontend'|'icurry']", help='selects the route from Curry to ICurry: the Curry front end with the built-in translation (default) or icurry')

  OPTS = parser.parse_args()
  if OPTS.jobs is None:
    OPTS.jobs = DEFAULT_JOBS
  OPTS.write_config = not OPTS.check_prereqs and not OPTS.install_prereqs_only
  OPTS.install_prereqs = OPTS.install_prereqs or not OPTS.write_config
  if OPTS.cache not in [None, 'all', 'icurry', 'json']:
    warn('invalid argument to --enable-cache')
    warn('    expected %r, %r or %r' % ('all', 'icurry', 'json'))
    warn('    got %r' % OPTS.cache)
    abort()

# Validation.
def executable(program):
  log('Checking whether %s is executable' % program, '...')
  ok = os.access(program, os.R_OK | os.X_OK)
  log('OK' if ok else 'FAILED')
  return ok

def readable(filename):
  log('Checking whether %s is readable' % filename, '...')
  ok = os.access(filename, os.R_OK)
  log('OK' if ok else 'FAILED')
  return ok

def readabledir(dirname):
  log('Checking whether %s is a readable directory' % dirname, '...')
  ok = os.access(dirname, os.R_OK)
  ok = ok and os.path.isdir(dirname)
  log('OK' if ok else 'FAILED')
  return ok

def main():
  get_options()
  if OPTS.check_prereqs:
    say('Checking prerequisites.')
  else:
    say('Configuring Sprite.')

  # Preparation.
  os.chdir(DIR)
  remove_tmpdir()
  os.mkdir(TMP)
  if OPTS.write_config:
    rmdir(os.path.join(DIR, 'install'))
    rmdir(os.path.join(DIR, 'object-root'))

  # Determine the settings.
  say('*** Finding programs')
  try:
    settings = {
        'ENABLE_ICURRY_CACHE'     : int(OPTS.cache in ['all', 'icurry'])
      , 'ENABLE_PARSED_JSON_CACHE': int(OPTS.cache in ['all', 'json'])
      , 'JOBS'                    : OPTS.jobs
      }
    log('Selecting JOBS=%r' % OPTS.jobs)
    set_from_path(
        settings, 'PYTHON', 'python3', 'Python installation'
      , default=OPTS.with_python
      )
    set_from_path(settings, 'CC', 'gcc', 'GNU C compiler'
      , install_steps=get_build_essential_install_steps
      , default=OPTS.with_cc
      )
    set_from_path(settings, 'CXX', 'g++', 'GNU C++ compiler'
      , install_steps=get_build_essential_install_steps
      , default=OPTS.with_cxx
      )
    set_from_path(settings, 'CXX_POSTINSTALL', 'g++', 'GNU C++ compiler'
      , install_steps=get_build_essential_install_steps
      , default=OPTS.with_cxx_postinstall
      )
    set_ccache(settings)
    set_pakcs(settings)
    set_frontend(settings)
    set_icurry(settings)
    set_from_path(settings, 'BOOST', 'boost', 'Boost libraries'
      , web='https://www.boost.org'
      , install_steps=[
            '# Install Boost.'
          , 'sudo apt-get install libboost-all-dev'
          ]
      , path=['/usr/local/include', '/usr/include']
      , validation=[readabledir]
      )

    if 'PYTHON' in settings:
      say('*** Checking Python')
      check_python_version(settings)
      check_python_modules(settings)
      set_python_config(settings)
    if settings.get('PAKCS'):
      say('*** Checking PAKCS')
      set_pakcs_home(settings)
      set_pakcs_name(settings)
      set_pakcs_version(settings)
    else:
      set_pinned_pakcs(settings)
    set_frontend_flags(settings)
    if settings.get('CURRY_FRONTEND') and not OPTS.fast:
      say('*** Checking the Curry front end')
      check_frontend(settings)
    if settings.get('ICURRY') and not OPTS.fast:
      say('*** Checking ICurry (this takes some time).')
      check_icurry(settings)
    set_curry2icurry_tool(settings)

  except KeyboardInterrupt:
    abort()
  except EOFError:
    abort()

  if OPTS.check_prereqs:
    say()
    if g_install_steps or g_missing_prereqs:
      say(get_banner('SUMMARY', '='))
      say()
      say('Missing: %s' % ', '.join(g_missing_prereqs))
      say()
      say('Installation steps:')
      say('(rerun with --install-prereqs[-only] [--yes] to install)')
      say()
      say('\n'.join('    ' + step for step in g_install_steps))
      say()
    say('Prerequisite check complete.')
    n_prob = len(g_missing_prereqs)
    say('Found %s problem%s.' % (n_prob, '' if n_prob == 1 else 's'))

  if OPTS.write_config:
    # Render the output file.
    text = TEMPLATE.format(**settings)
    with open(CONF, 'w') as ostream:
      ostream.write(text)
    say()
    say('****** Configuration succeeded! ******')
    say('Details logged to %s' % LOGFILE)
    say('Configuration written to %s' % CONF)
  else:
    say()
    say('Details logged to %s' % LOGFILE)
    say('Configuration NOT written.')

def set_from_path(
    settings, variable_name, program_name, desc, web=None, hint=None
  , altdir=None, default=None, install_steps=None, path=None
  , validation=[executable], allow_interact=True, required=True
  ):
  if default is None:
    if variable_name is not None:
      default = os.environ.get(variable_name)
    if default is not None: log("Using default %s=%r from the environment" % (variable_name, default))

  if default is None or os.sep not in default:
    program_name = program_name if default is None else default
    default = which(program_name, path=path)
    if default is None and altdir is not None:
      default = os.path.join(altdir, program_name)
      default = os.path.abspath(default)
      if not os.path.exists(default):
        default = None

  if default is None and web is not None:
    more = 'See %s\n' % web
  else:
    more = ''

  if OPTS.interactive and allow_interact:
    while True:
      value = input('\nPlease specify the %s [%s]\n%s> ' % (desc, default, more))
      if not value:
        if default is None and OPTS.install_prereqs:
          say('%s will be installed.  Checking its prerequisites now.' % desc)
          break
        value = default
      if commit(settings, variable_name, value, validation):
        return
  if default is None:
    steps = list(
        install_steps(settings) if callable(install_steps) else install_steps
      ) if install_steps else None
    installed = handle_missing_prereq(
        program_name
      , '%r is %s.' % (desc, 'required' if required else 'recommended')
      , steps
      , required=required
      , web=web
      , hint=hint
      )
    if installed:
      set_from_path(
          settings, variable_name, program_name, desc, web, hint, altdir
        , path=path, validation=validation, allow_interact=False
        )
    return
  if not commit(settings, variable_name, default, validation):
    abort()

def check_python_version(settings):
  log('Checking the Python version', '...')
  vstr = shell(
      '''{} -c "import sys; sys.stdout.write('%s.%s.%s' % sys.version_info[:3])"'''
          .format(settings['PYTHON'])
    )
  vtuple = tuple(int(x) for x in vstr.split('.'))
  minimum = 3,14,0
  if vtuple < minimum:
    log('FAILED')
    warn('Sprite requires Python 3.14 or newer; found %s' % vstr)
    abort()
  else:
    log('%s, OK' % vstr)

g_num_warnings = 0

def check_python_modules(settings):
  modules = [
    #  module              req'd  enabled     whatfor
    # -----------------------------------------------------------------
      ('json'            , True , True      , None                    )
    , ('mmap'            , True , True      , None                    )
    , ('numpy'           , False, True      , 'for certain tests'     )
    , ('sphinx'          , False, OPTS.doc  , 'to build documentation')
    , ('sphinx_rtd_theme', False, OPTS.doc  , 'for HTML theming'      )
    , ('sqlite3'         , False, OPTS.cache, 'for caching'           )
    , ('zlib'            , True , True      , None                    )
    ]
  for modname,required,enabled,whatfor in modules:
    check_python_module(settings, modname, required, enabled, whatfor)

def ensurepip(settings, required, whatfor):
  pyexe = settings['PYTHON']
  global g_did_pipcheck
  if not g_did_pipcheck:
    g_did_pipcheck = True
    # if OPTS.pip_nosudo:
    #   steps = [
    #       '# Install pip.'
    #     , '%s -m ensurepip --user' % pyexe
    #     ]
    # else:
    #   steps = [
    #       '# Install pip.'
    #     , 'sudo %s -m ensurepip' % pyexe
    #     ]
    check_python_module(settings, 'pip', required, True, whatfor)

def check_python_module(
    settings, modname, required, enabled, whatfor, steps=None
  ):
  pyexe = settings['PYTHON']
  try:
    if enabled:
      log('Checking for module %r' % modname, '...')
      shell("""%s -c 'import %s'""" % (pyexe, modname))
      log('OK')
  except subprocess.CalledProcessError:
    log('FAILED')
    msg='The Python %r module is %s%s.' % (
        modname
      , 'required' if required else 'recommended'
      , ' %s' % whatfor if whatfor is not None else ''
      )
    if steps is None:
      steps = [
          '# Install %s.' % modname
        , '%s -m pip install --user %s' % (pyexe, modname)
        ]
    handle_missing_prereq(
        modname, msg, steps, required
      , deps=lambda: ensurepip(settings, required, 'to install %s' % modname)
      )
    settings['HAVE_PYTHON_' + modname] = 0
  else:
    settings['HAVE_PYTHON_' + modname] = 1

def get_banner(title, char='-', width=80):
  title = ' %s ' % title
  n = max(3, (width - len(title)) // 2)
  return char * n + title + char * n

def handle_missing_prereq(
    name, msg, steps=None, required=True, web=None, hint=None
  , deps=None
  ):
  global g_num_warnings, g_missing_prereqs, g_install_steps
  g_num_warnings += 1
  g_missing_prereqs.append(name)
  warn()
  warn(get_banner('PREREQUISITE ISSUE #%s' % g_num_warnings))
  warn()
  warn('    ' + msg)
  warn()
  if steps:
    warn('    Suggestion:')
    warn('')
    for step in steps:
      warn('        ' + step)
    warn('')
  if deps is not None:
    deps()
  if steps:
    g_install_steps += (list(steps) + [''])
  if OPTS.check_prereqs:
    return False
  if OPTS.install_prereqs and steps:
    if install(name, steps):
      return True
  if not required:
    # A missing optional prerequisite is a warning, not an error.
    return False
  if web is not None:
    warn('For installation info, see %s' % web)
  if hint is not None:
    warn('hint: %s' % hint)
  abort()

PYTHON_CONFIG_SCRIPT = \
r'''
import sys, sysconfig
for val in sysconfig.get_config_vars('CONFINCLUDEPY', 'LIBDIR', 'MULTIARCH', 'LDVERSION'):
  sys.stdout.write(str(val))
  sys.stdout.write('\n')
'''

def set_python_config(settings):
  scriptname = os.path.join(TMP, 'version_script.py')
  with open(scriptname, 'w') as ostream:
    ostream.write(PYTHON_CONFIG_SCRIPT)
  data = shell('%s %s' % (settings['PYTHON'], scriptname))
  include, libdir, multiarch, ldversion = data.split('\n')

  keyfile = os.path.join(include, 'pyconfig.h')
  if not commit(settings, 'PYTHON_INCLUDE_PATH', include, [readabledir, lambda _: readable(keyfile)]):
    abort_python()

  if not commit(settings, 'PYTHON_LIBRARY_PATH', libdir, [readabledir]):
    abort_python()
  pylib = 'python' + ldversion
  commit(settings, 'PYTHON_LIBRARY', pylib)

  # A shared libpython is not required.  Python extension modules resolve the
  # interpreter's symbols when they are loaded.  Report what was found.
  soname = 'lib%s.so' % pylib
  log('Looking for %r' % soname, '...')
  for maybe_libdir in [libdir, os.path.join(libdir, multiarch)]:
    libfile = os.path.join(maybe_libdir, soname)
    if os.access(libfile, os.R_OK):
      log('found %s, OK' % libfile)
      break
  else:
    log('not found (not required)')

def requested(option, variable_name):
  '''
  The program named by a --with option or by the environment, or None.  The
  empty string means that the program is left out by request.
  '''
  if option is not None:
    return option
  return os.environ.get(variable_name)

def set_ccache(settings):
  '''
  Finds ccache when --with-ccache or CCACHE in the environment asks for it.
  ccache then runs in front of the compilers of the build (see
  src/Make.depends), and tools/cxx of the installation becomes a script that
  runs ccache in front of the post-install compiler (see
  src/export/tools/Makefile).  Without the option, or with an empty value,
  the compilers run as they are.
  '''
  given = requested(OPTS.with_ccache, 'CCACHE')
  if given is None:
    log('ccache is not configured.  Pass --with-ccache to put it in front '
        'of the compilers.')
    settings['CCACHE'] = ''
    return
  if given == '':
    log('ccache is left out by request.')
    settings['CCACHE'] = ''
    return
  set_from_path(settings, 'CCACHE', 'ccache', 'ccache program'
    , web='https://ccache.dev'
    , install_steps=[
          '# Install ccache.'
        , 'sudo apt-get install ccache'
        ]
    , default=given
    )
  settings.setdefault('CCACHE', '')

def set_frontend(settings):
  '''
  Finds the Curry front end.  By default it is the pakcs-frontend of the
  selected PAKCS.  It is required: both routes from Curry to ICurry run it
  (the icurry route runs it first and rewrites its FlatCurry file before
  icurry reads it; see curry.toolchain._curry2icurry).
  '''
  given = requested(OPTS.with_curry_frontend, 'CURRY_FRONTEND')
  if given == '':
    log('The Curry front end is left out by request.')
    settings['CURRY_FRONTEND'] = ''
    return
  default = given
  if default is None and settings.get('PAKCS'):
    bindir = os.path.dirname(os.path.realpath(settings['PAKCS']))
    candidate = os.path.join(bindir, 'pakcs-frontend')
    if os.path.exists(candidate):
      default = candidate
  set_from_path(settings, 'CURRY_FRONTEND', 'pakcs-frontend', 'Curry front end'
    , web='https://www.curry-lang.org/pakcs/'
    , hint='the front end comes with PAKCS, as bin/pakcs-frontend'
    , default=default
    )
  settings.setdefault('CURRY_FRONTEND', '')

def set_icurry(settings):
  '''
  Finds icurry.  It is optional: it is configured only when requested, and
  the Curry front end is required with it (see set_frontend).
  '''
  given = requested(OPTS.with_icurry, 'ICURRY')
  if given == '':
    log('icurry is left out by request.')
    settings['ICURRY'] = ''
    return
  if given is None and settings.get('CURRY_FRONTEND'):
    log('icurry is not needed: the Curry front end was found.  Pass '
        '--with-icurry to configure it as the alternative.')
    settings['ICURRY'] = ''
    return
  set_from_path(settings, 'ICURRY', 'icurry', 'icurry executable'
    , web='https://www.curry-lang.org/tools/cpm/'
    , hint='try `cypm update; cypm install icurry 3.1.0`'
    , altdir=os.path.join(os.environ.get('HOME', ''), '.cpm', 'bin')
    , install_steps=get_icurry_install_steps
    , default=given
    )
  settings.setdefault('ICURRY', '')

def set_pakcs(settings):
  '''
  Finds PAKCS.  Sprite needs only its front end, which --with-curry-frontend
  can name directly, and the functional tests use pakcs as the oracle.  So
  PAKCS is optional: --with-pakcs '' leaves it out, and when the front end
  was named, a missing PAKCS is a warning.  Without PAKCS the pinned release
  names the intermediate directories; see set_pinned_pakcs.
  '''
  given = requested(OPTS.with_pakcs, 'PAKCS')
  if given == '':
    log('PAKCS is left out by request.')
    settings['PAKCS'] = ''
    return
  frontend_given = bool(requested(OPTS.with_curry_frontend, 'CURRY_FRONTEND'))
  set_from_path(settings, 'PAKCS', 'pakcs', 'PAKCS executable'
    , web='https://www.curry-lang.org/pakcs/'
    , altdir='extern/pakcs-3.4.1/bin'
    , install_steps=None if frontend_given else get_pakcs_install_steps
    , default=given
    , required=not frontend_given
    )
  settings.setdefault('PAKCS', '')

def set_pinned_pakcs(settings):
  '''
  The PAKCS settings of a build without PAKCS.  The name and the version of
  the pinned release name the intermediate directories (.curry/pakcs-3.4.1
  and .curry/sprite-pakcs-3.4.1) and set the front-end flags, so the
  committed ICurry files stay valid.
  '''
  log('PAKCS is not configured.  Using the pinned release %s %s.'
      % (PINNED_PAKCS_NAME, PINNED_PAKCS_VERSION))
  commit(settings, 'PAKCS_HOME', '')
  commit(settings, 'PAKCS_NAME', PINNED_PAKCS_NAME)
  commit(settings, 'PAKCS_VERSION', PINNED_PAKCS_VERSION)

def set_frontend_flags(settings):
  '''
  The options Sprite passes to the front end.  __PAKCS__ is defined as the
  PAKCS version, major times 100 plus minor, as PAKCS itself and icurry do.
  '''
  major, minor = (int(x) for x in settings['PAKCS_VERSION'].split('.')[:2])
  flags = '--extended -D__PAKCS__=%d' % (major * 100 + minor)
  commit(settings, 'CURRY_FRONTEND_FLAGS', flags)

def check_frontend(settings):
  '''
  Checks that the Curry front end runs and has the pinned version.  The
  caches under curry/lib and the overlay archive hold its FlatCurry, so
  another version is an error.
  '''
  frontend = settings['CURRY_FRONTEND']
  GOOD_FRONTEND_VERSIONS = [PINNED_FRONTEND_VERSION]
  log('Checking the Curry front end version', '...')
  try:
    ver = shell('%s --numeric-version' % frontend)
  except subprocess.CalledProcessError:
    log('FAILED')
    warn('Failed to run the Curry front end %s' % frontend)
    abort()
  ok = ver in GOOD_FRONTEND_VERSIONS
  log('%s, %s' % (ver, 'OK' if ok else 'FAILED'))
  if not ok:
    warn('Acceptable Curry front end versions are: %s' % GOOD_FRONTEND_VERSIONS)
    warn('The front end comes with PAKCS %s.' % PINNED_PAKCS_VERSION)
    abort()

def set_curry2icurry_tool(settings):
  '''
  The route from Curry to ICurry used by default.  The front end wins when
  it is configured, unless --curry2icurry says otherwise.
  '''
  frontend = settings.get('CURRY_FRONTEND')
  icurry = settings.get('ICURRY')
  tool = OPTS.curry2icurry
  if tool is None:
    tool = 'frontend' if frontend else 'icurry' if icurry else ''
  if (tool == 'frontend' and not frontend) or (tool == 'icurry' and not icurry):
    warn('--curry2icurry=%s was requested, but that tool is not configured.' % tool)
    if not OPTS.check_prereqs:
      abort()
  if not frontend and not OPTS.check_prereqs:
    warn('The Curry front end is not configured.  Both routes from Curry to '
         'ICurry run it: the icurry route rewrites its FlatCurry file before '
         'icurry reads it.')
    abort()
  commit(settings, 'CURRY2ICURRY_TOOL', tool)

def set_pakcs_home(settings):
  pakcs = settings['PAKCS']
  dirname = os.path.dirname(pakcs)
  parent = os.path.join(dirname, '..')
  pakcshome = os.path.realpath(parent)
  commit(settings, 'PAKCS_HOME', pakcshome, [readabledir])

def set_pakcs_name(settings):
  pakcs = settings['PAKCS']
  log('Checking the PAKCS compiler name', '...')
  name = shell('%s --compiler-name' % pakcs)
  ok = (name == 'pakcs')
  log('OK' if ok else 'FAILED')
  if not ok:
    log('The PAKCS Curry system is required.')
    abort()
  commit(settings, 'PAKCS_NAME', name)

def set_pakcs_version(settings):
  pakcs = settings['PAKCS']
  GOOD_PAKCS_VERSIONS = [PINNED_PAKCS_VERSION]
  log('Checking the PAKCS version', '...')
  ver = shell('%s --numeric-version' % pakcs)
  ok = ver in GOOD_PAKCS_VERSIONS
  log('OK' if ok else 'FAILED')
  if not ok:
    warn('Acceptable PAKCS versions are: %s' % GOOD_PAKCS_VERSIONS)
    abort()
  commit(settings, 'PAKCS_VERSION', ver)

def check_icurry(settings):
  log('Checking the behavior of the icurry program')
  icurry = settings['ICURRY']
  filename = os.path.join(TMP, 'sample.curry')
  with open(filename, 'w') as ostream:
    ostream.write('main :: Int\n')
    ostream.write('main = 42\n')
  try:
    shell('cd %s && %s sample' % (TMP, icurry))
  except subprocess.CalledProcessError:
    warn('Failed to run icury')
    abort()

  # Look for the expected files and directories.
  currydir = os.path.join(TMP, '.curry')
  pakcs_subdir_name = '{PAKCS_NAME}-{PAKCS_VERSION}'.format(**settings)
  pakcs_subdir = os.path.join(currydir, pakcs_subdir_name)
  if not all([
      readabledir(currydir)
    , readabledir(pakcs_subdir)
    , readable(os.path.join(pakcs_subdir, 'sample.icy'))
    ]):
    abort()

def install(name, steps):
  steps = list(steps)
  if not OPTS.yes:
    warn()
    warn('-' * 80)
    warn('configure wants to install %r:' % name)
    warn()
    for step in steps:
      warn('    ' + step)
    warn()

    while True:
      warn('(run configure with --yes to skip this question)')
      go = input('Continue? [Y/n]> ')
      if not go or go in 'yY':
        break
      elif go in 'nN':
        return False

  for step in steps:
    if step and not step.startswith('#'):
      say('% ' + step)
      if not shellexec(step):
        abort()
  return True

def prereq_curl():
  set_from_path(None, None, 'curl', 'curl program'
    , install_steps=[
        '# Install curl.'
      , 'sudo apt-get install curl'
      ]
    , allow_interact=False
    )

def prereq_cypm(settings):
  # cypm ships with PAKCS.  Return None when PAKCS has not been found.
  if settings is None or not settings.get('PAKCS'):
    return None
  dirname,pakcs = os.path.split(settings['PAKCS'])
  cypm = os.path.join(dirname, 'cypm')
  if not executable(cypm):
    abort()
  return cypm

def prereq_make():
  set_from_path(None, None, 'make', 'make program'
    , install_steps=get_build_essential_install_steps
    , allow_interact=False
    )

def prereq_sqlite3():
  set_from_path(None, None, 'sqlite3', 'sqlite3 program'
    , install_steps=[
          '# Install SQLITE.'
        , 'sudo apt-get install sqlite'
        ]
    )

def prereq_tar():
  set_from_path(None, None, 'tar', 'tar program', allow_interact=False)

def prereq_wget():
  set_from_path(None, None, 'wget', 'wget program'
    , install_steps=[
        '# Install wget.'
      , 'sudo apt-get install wget'
      ]
    , allow_interact=False
    )

def get_build_essential_install_steps(settings=None):
  yield '# Install gcc, g++, make.'
  yield 'sudo apt-get install build-essential'

def get_pakcs_install_steps(settings=None):
  prereq_make()
  prereq_tar()
  prereq_wget()
  prereq_curl()
  prolog = {}
  set_from_path(prolog, 'PROLOG', 'swipl', 'Prolog system'
    , install_steps=[
          '# Install SWI Prolog.'
        , 'sudo apt-get install swi-prolog'
        ]
    , default=OPTS.with_prolog
    )
  swipl = prolog.get('PROLOG', 'swipl')
  yield '# Install the PAKCS 3.4.1 binary distribution.'
  pakcs_dir = 'extern/pakcs-3.4.1'
  pakcs_url = 'https://www.curry-lang.org/pakcs/download/pakcs-3.4.1-amd64-Linux.tar.gz'
  pakcs_tar = 'extern/pakcs-3.4.1-amd64-Linux.tar.gz'

  if not os.path.exists(pakcs_dir):
    if not os.path.exists(pakcs_tar):
      yield 'wget -P extern --no-clobber %s' % pakcs_url
    yield 'tar xzf %s -C extern' % pakcs_tar
  yield 'cd %s && LC_ALL=C.UTF-8 make SWIPROLOG=%s' % (pakcs_dir, swipl)

def get_icurry_install_steps(settings=None):
  cypm = prereq_cypm(settings)
  prereq_sqlite3()
  yield '# Install icurry.'
  if cypm is None:
    yield '# PAKCS must be found first.  cypm is installed with PAKCS.'
    yield '# After PAKCS is installed, rerun configure.'
  else:
    yield '%s update' % cypm
    yield '%s install icurry 3.1.0' % cypm


TEMPLATE = r'''
# Python Configuration
# ====================
PYTHON_EXECUTABLE   := {PYTHON}
PYTHON_INCLUDE_PATH := {PYTHON_INCLUDE_PATH}
PYTHON_LIBRARY_PATH := {PYTHON_LIBRARY_PATH}
PYTHON_LIBRARY      := {PYTHON_LIBRARY}

# C/C++ Compilers
# ===============
CC  := {CC}
CXX := {CXX}
# Used to compile Curry for the 'cxx' backend.
CXX_POSTINSTALL := {CXX_POSTINSTALL}

# ccache (configure --with-ccache)
# ================================
# When set, ccache runs in front of CC and CXX when the build compiles an
# object (see src/Make.depends), and tools/cxx of the installation is a
# script that runs ccache in front of CXX_POSTINSTALL (see
# src/export/tools/Makefile), so the code of the C++ backend compiles through
# ccache as well.  ccache changes nothing in the output of the compiler, and
# the ABI stamps of the compiled modules do not depend on it.  Empty: the
# compilers run as they are.
CCACHE := {CCACHE}

# Parallel build (configure --jobs)
# =================================
# The number of jobs the top-level make runs at once: a count, or auto for
# one job per processor, counted when make starts.  1 is a serial build.  The
# root Makefile turns the value into -j; the sub-makes join its job server.
# A -j on the make command line wins, and so does make JOBS=N.
JOBS := {JOBS}

# Build flavor
# ============
# The optimized flavor, the default, is the release build.  It drops the
# assertions (-DNDEBUG) and the stack protector, calls out of a translation
# unit without the procedure linkage table, and lets the compiler bind the
# functions of a translation unit locally.  The debug flavor (make DEBUG=1)
# keeps the assertions.  CXX_FLAVOR reaches the installation as
# sysconfig/cxx_flavor, and the C++ backend compiles generated modules in the
# same flavor (see curry.backends.cxx.toolchain).  A change here rebuilds
# every object (see src/Make.depends).
ifeq ($(DEBUG),1)
  CXX_FLAVOR := debug
  CFLAGS   += -O0 -ggdb -Wno-register -Wall
else
  CXX_FLAVOR := release
  CFLAGS   += -O2 -DNDEBUG -fno-stack-protector -fno-plt \
              -fno-semantic-interposition -Wno-register -Wall
endif
ifeq ($(TRACE),1)
  CFLAGS   += -DSPRITE_TRACE_ENABLED
endif
# The scheduler counters (make COUNTERS=1): the serial fraction, the
# lifetimes of configurations, and the shared work of an evaluation, reported
# by sprite-exec --stats.  They change the runtime library and the bindings
# only, not the generated code.  See src/cyrt/state/counters.hpp.  The
# objects do not depend on this variable: touch Make.config to switch.
ifeq ($(COUNTERS),1)
  CFLAGS   += -DSPRITE_SCHEDULER_COUNTERS
endif
# The collector of the C++ runtime (make GC=mps): the Memory Pool System
# (the submodule extern/mps) in place of the block heap and the
# mark-and-sweep collector of src/cyrt/graph/gc.  An experiment behind a
# gate (see TODO); the default, wdgc, is the collector of the tree.  The
# choice reaches the installation as sysconfig/cxx_gc, and the C++ backend
# compiles generated modules with the same macro (see
# curry.backends.cxx.toolchain).  The objects do not depend on this
# variable: touch Make.config to switch.
GC ?= wdgc
ifeq ($(GC),mps)
  CFLAGS   += -DSPRITE_GC_MPS -I$(ROOT_DIR)/extern/mps/code
endif
# The counters of writes into old nodes (make GC_WRITE_COUNTERS=1 builds
# them in): a test at every return of a step in the scheduler and at the
# sites that write a pointer into an existing node, for the measurements
# of the generational design (see src/cyrt/graph/gc/wdgc.cpp and the TODO
# entry).  They cost a tenth of the instructions of Tak1, so the default
# leaves them out: without the macro the sites are empty inline functions
# that cost nothing.  Some sites are in the installed headers, so the
# setting reaches the installation as sysconfig/cxx_gc_write_counters, and
# the C++ backend compiles generated modules with the same macro, and again
# when it changes (the ABI stamp; see curry.backends.cxx.toolchain).  The
# counters belong to the block heap, so the setting has no effect under
# GC=mps.  The objects of the runtime do not depend on this variable: touch
# Make.config to switch.
GC_WRITE_COUNTERS ?= 0
CXX_GC_WRITE_COUNTERS := 0
ifeq ($(GC),wdgc)
  ifeq ($(GC_WRITE_COUNTERS),1)
    CFLAGS   += -DSPRITE_GC_WRITE_COUNTERS
    CXX_GC_WRITE_COUNTERS := 1
  endif
endif
CXXFLAGS += $(CFLAGS) -std=c++17

# PAKCS
# =====
# PAKCS is an implementation of Curry.  Sprite uses its front end to
# translate Curry to FlatCurry, and the tests use it as the oracle.
# The Curry library does not come from it: Sprite ships its own copy under
# curry/lib.  Download PAKCS from https://www.curry-lang.org/pakcs/.
# PAKCS may be empty (configure --with-pakcs '').  PAKCS_NAME and
# PAKCS_VERSION then name the pinned release.  They name the intermediate
# directories under .curry and must not change.
PAKCS         := {PAKCS}
PAKCS_HOME    := {PAKCS_HOME}
PAKCS_NAME    := {PAKCS_NAME}
PAKCS_VERSION := {PAKCS_VERSION}

# Curry front end
# ===============
# The front end translates Curry to FlatCurry.  It comes with PAKCS.  Sprite
# runs it and then its own translation from FlatCurry to ICurry.  The flags
# follow the output directory and the search path on the command line.  They
# must stay as they are, or the ICurry differs from the committed files.
CURRY_FRONTEND       := {CURRY_FRONTEND}
CURRY_FRONTEND_FLAGS := {CURRY_FRONTEND_FLAGS}

# ICURRY
# ======
# The icurry program is the alternative route from Curry to ICurry.  It is
# optional.  configure --with-icurry selects it; see
# https://www.curry-lang.org/tools/cpm/.  Leave the value empty to omit it.
ICURRY_EXECUTABLE := {ICURRY}

# The route from Curry to ICurry used by default: frontend or icurry.  The
# environment variable SPRITE_CURRY2ICURRY overrides it at run time.
CURRY2ICURRY_TOOL := {CURRY2ICURRY_TOOL}

# MISC
# ====
HAVE_PYTHON_numpy   := {HAVE_PYTHON_numpy}
HAVE_PYTHON_sqlite3 := {HAVE_PYTHON_sqlite3}
HAVE_PYTHON_sphinx  := {HAVE_PYTHON_sphinx}

# Sprite Configuration
# ====================
# The name of the top-level Python package, e.g., curry in 'import curry'.
PYTHON_PACKAGE_NAME := curry

# The name of the backed used by default.  Must match one of the subpackages
# under src/python/backends.
DEFAULT_BACKEND := py

# Caching (development feature)
# =============================
# Sprite can cache the output of the Curry front end (Curry to ICurry) and the
# parsing of ICurry-JSON in an SQLite database.  The front end takes seconds
# per module, so the cache pays off when the same programs are compiled many
# times, as in the unit tests.  The test drivers turn the ICurry cache on
# through SPRITE_CACHE_FILE; the settings below give the default for every
# other use.
#
# The following environment variables control caching at *runtime*:
#
#     SPRITE_CACHE_FILE
#       Names the cache file and turns the ICurry cache on.  Setting this to
#       the empty string disables caching.  When the variable is not set, the
#       settings below apply.
#
#     SPRITE_CACHE_UPDATE=<pattern>
#       Updates the cached data of the files matching the pattern: the Curry
#       source file for the ICurry cache, the JSON file for the parsed-JSON
#       cache.  The pattern is a glob unless it is enclosed with slashes (/),
#       in which case it is a regular expression.  Regex patterns are not
#       anchored, so the pattern needs only to match some part of the file
#       name.
#
#       Examples:
#           SPRITE_CACHE_UPDATE='*'         -- update everything
#           SPRITE_CACHE_UPDATE='*.json'    -- update JSON data
#           SPRITE_CACHE_UPDATE='/foo\d+/'  -- update files associated with
#                                           -- foo00.curry, foo01.curry, etc.

# This specifies the file to use by default for caching.  Clear the value to
# disable caching by default.  The environment variable SPRITE_CACHE_FILE can
# be used when invoking Sprite to override this or disable caching altogether.
DEFAULT_SPRITE_CACHE_FILE := {{HOME}}/.sprite/cache.db

# Whether to cache Curry-to-ICurry conversions by default.  An entry is keyed
# by a digest of the module source, of the sources of the modules it imports,
# and of the front-end options, not by the file name; see curry.cache.
ENABLE_ICURRY_CACHE := {ENABLE_ICURRY_CACHE}

# Whether to cache parsing of ICurry-JSON.  If True, the cache file will store
# the result of loading a JSON file into Python.  The stored data consists of
# pickled objects from the curry.icurry module.
ENABLE_PARSED_JSON_CACHE := {ENABLE_PARSED_JSON_CACHE}
'''

# MPS
# ===
# The Memory Pool System is the submodule extern/mps.  make GC=mps builds the
# C++ runtime with it in place of the collector of the tree (see Make.config
# and src/cyrt/graph/gc/mps.cpp).  Nothing here configures it.


